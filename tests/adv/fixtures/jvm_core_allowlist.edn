;; Allowlist for the jvm-core differential probe. Keys are probe keys
;; ("ns/var:aspect"); values are the owning fix or documented
;; divergence. Two-tier lookup in diff_jvm_core.clj: exact key first,
;; then a prefix covering every probe beneath it. As each mino fix
;; lands, its entries are deleted and the probes must pass.
{"apply.nonseq-tail" "fix: apply non-seqable tail"
 "char-array.from-string" "fix: char-array from string"
 "disj.no-keys" "fix: disj no keys"
 "disj.no-keys-set" "fix: disj no keys"
 "char-array.sized-init" "fix: sized char-array"
 "double-array.sized-init" "fix: sized double-array"
 "replace.transducer" "fix: replace transducer"
 "destructure.bare-string" "fix: destructure passthrough"
 "str.float-exp" "fix: str float path"
 "syntax-quote.unresolvable" "fix: syntax-quote qualification"
 "def.var-roundtrip" "fix: def returns var"
 "clojure-string.bare-capitalize" "fix: clojure.string preload"
 "clojure-string.bare-reverse" "fix: clojure.string preload"
 "catch.class-slot" "fix: classed catch"
 "catch.class-binding" "fix: classed catch"
 "meta.arglists-map" "fix: arglists metadata"
 "meta.arglists-defn" "fix: arglists metadata"
 "lenient.distinct-set" "documented: distinct on set"
 "lenient.satisfies-garbage" "documented: satisfies lenient"
 "lenient.re-seq-string-pattern" "documented: string patterns"
 "lenient.identical-strings" "documented: identical literals"
 "lenient.chunked-range" "documented: chunked representation"
 "lenient.atom-repr" "documented: atom repr"}
