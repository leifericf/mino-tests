;; Allowlist of ClojureDocs examples whose mino output INTENTIONALLY
;; differs from bb / JVM Clojure. The probe loads this file and
;; treats matched examples as "skip" (not "fail").
;;
;; Two key shapes are supported:
;;   "clojure.ns/var-name"         -- skip every example of this var
;;   "clojure.ns/var-name:<idx>"   -- skip just example #idx
;; The probe checks the exact-index key first, then falls back to the
;; var-wildcard. The value is a short reason string used in verdict
;; output; longer rationale lives next to the relevant CHANGELOG entry.
;;
;; Add entries here only for divergences mino keeps on purpose.
;; A divergence that's "just a bug" should land in mino/.local/BUGS.md
;; and get fixed; the allowlist isn't a place to silence open issues.
;; Most entries below are host-layer divergences covered by mino
;; ADR 67 (conformance targets the language, not the reference host).
;; Prefer indexed entries when some examples of a var pass: a wildcard
;; over a partially-passing var throws away real conformance signal.
;; Full audit 2026-09-12: every entry below re-verified against a live
;; run; stale, dead, and since-fixed entries removed.

{
 ;; --- Java arrays (mino ADR 67) ---
 ;;
 ;; mino ships a minimal typed-array surface but not the JVM's
 ;; host-mutable array ecosystem. The wildcard vars below either have
 ;; no mino counterpart (constructors/casts like amap, make-array,
 ;; to-array-2d, the coercion fns) or print JVM #object forms.
 ;; Indexed entries cover the specific examples that lean on those;
 ;; the same vars' other examples pass on mino's own array support.
 "clojure.core/aget:4"           "make-array + multi-index aget are host-array surface (ADR 67)"
 "clojure.core/aset:0"           "to-array-2d preamble is host-array surface (ADR 67)"
 "clojure.core/aset:1"           "to-array-2d preamble is host-array surface (ADR 67)"
 "clojure.core/aset:2"           "to-array-2d preamble is host-array surface (ADR 67)"
 "clojure.core/int-array:1"      "JVM #object print form for the array value (ADR 67)"
 "clojure.core/double-array:0"   "JVM #object print form for the array value (ADR 67)"
 "clojure.core/to-array:2"       "JVM preserves array identity through to-array (ADR 67)"
 "clojure.core/bytes"            "host type-cast fn not in mino (ADR 67)"
 "clojure.core/chars"            "amap + host type-cast fns not in mino (ADR 67)"
 "clojure.core/doubles"          "amap + host type-cast fns not in mino (ADR 67)"
 "clojure.core/floats"           "amap + host type-cast fns not in mino (ADR 67)"
 "clojure.core/ints"             "amap + host type-cast fns not in mino (ADR 67)"
 "clojure.core/longs"            "amap + host type-cast fns not in mino (ADR 67)"
 "clojure.core/shorts"           "amap + host type-cast fns not in mino (ADR 67)"
 ;; Var-absent guards: these vars have no runnable corpus examples
 ;; today but would diverge on any corpus refresh, for the same
 ;; ADR 67 reason. Vars with runnable examples (aget, aset,
 ;; int-array, double-array, to-array) use indexed entries above so
 ;; their passing examples keep counting.
 "clojure.core/long-array"       "host-mutable arrays (ADR 67)"
 "clojure.core/short-array"      "host-mutable arrays (ADR 67)"
 "clojure.core/byte-array"       "host-mutable arrays (ADR 67)"
 "clojure.core/float-array"      "host-mutable arrays (ADR 67)"
 "clojure.core/char-array"       "host-mutable arrays (ADR 67)"
 "clojure.core/boolean-array"    "host-mutable arrays (ADR 67)"
 "clojure.core/object-array"     "host-mutable arrays (ADR 67)"
 "clojure.core/make-array"       "host-mutable arrays (ADR 67)"
 "clojure.core/to-array-2d"      "host-mutable arrays (ADR 67)"
 "clojure.core/into-array"       "host-mutable arrays (ADR 67)"
 "clojure.core/aset-int"         "host-mutable arrays (ADR 67)"
 "clojure.core/aset-long"        "host-mutable arrays (ADR 67)"
 "clojure.core/aset-char"        "host-mutable arrays (ADR 67)"
 "clojure.core/alength"          "host-mutable arrays (ADR 67)"
 "clojure.core/aclone"           "host-mutable arrays (ADR 67)"
 "clojure.core/amap"             "host-mutable arrays (ADR 67)"
 "clojure.core/areduce"          "host-mutable arrays (ADR 67)"
 "clojure.core/booleans"         "host type-cast fn not in mino (ADR 67)"

 ;; --- Hash function internals (mino ADR 67) ---
 ;;
 ;; mino's hash satisfies the documented invariant (= => same hash)
 ;; but is 64-bit and does not reproduce the JVM's exact int32
 ;; values. Empty-collection seeds happen to match; nothing else is
 ;; pinned.
 "clojure.core/hash-ordered-coll"   "hash is 64-bit mino impl, not JVM int32 (ADR 67)"
 "clojure.core/hash-unordered-coll" "hash is 64-bit mino impl, not JVM int32 (ADR 67)"
 "clojure.core/hash"                "hash is 64-bit mino impl, not JVM int32 (ADR 67)"

 ;; --- Non-deterministic fns ---
 ;;
 ;; By definition these can never byte-match across runtimes.
 ;; random-sample:1 passes only because its source is (repeat :foo),
 ;; so any sample prints identically.
 "clojure.core/shuffle"           "non-deterministic by design"
 "clojure.core/random-sample:0"   "non-deterministic by design"
 "clojure.core/random-sample:2"   "non-deterministic by design"
 "clojure.core/rand"              "non-deterministic by design"
 "clojure.core/rand-int"          "non-deterministic by design"
 "clojure.core/rand-nth"          "non-deterministic by design"
 "clojure.core/repeatedly:0"      "non-deterministic by design"
 "clojure.core/repeatedly:1"      "non-deterministic by design"

 ;; --- Java class introspection (mino ADR 67) ---
 "clojure.core/class"          "Java class introspection (ADR 67)"
 "clojure.core/type"           "Java class introspection (ADR 67)"

 ;; --- Set / map iteration and print order ---
 ;;
 ;; Unordered-collection print order is impl-defined; mino's HAMT and
 ;; the JVM hash the same elements to different buckets. Every entry
 ;; below was verified content-equal modulo order.
 "clojure.core/hash-set:0"        "set print order is impl-defined"
 "clojure.core/hash-set:2"        "set print order is impl-defined"
 "clojure.core/hash-set:3"        "set print order is impl-defined"
 "clojure.core/hash-map:2"        "small hash-map print order is impl-defined"
 "clojure.core/cons:3"            "set print order is impl-defined"
 "clojure.core/cons:4"            "set print order is impl-defined"
 "clojure.core/conj:8"            "set print order is impl-defined"
 "clojure.core/conj:13"           "set print order is impl-defined"
 "clojure.core/conj:14"           "set print order is impl-defined"
 "clojure.core/group-by:3"        "set-valued map keys print impl-defined"
 "clojure.core/merge-with:8"      "set-valued map values print impl-defined"
 "clojure.core/merge-with:9"      "set-valued map values print impl-defined"
 "clojure.core/merge-with:10"     "set-valued map values print impl-defined"
 "clojure.core/merge-with:11"     "set-valued map values print impl-defined"
 "clojure.core/reduce:0"          "set print order is impl-defined"
 "clojure.core/reduce:10"         "set print order is impl-defined"
 "clojure.core/keep:8"            "set iteration order is impl-defined"
 "clojure.core/remove:6"          "set iteration order is impl-defined"
 "clojure.core/remove:10"         "frequencies iteration order is impl-defined"
 "clojure.core/for:11"            "set print order is impl-defined"
 "clojure.set/union:0"            "small-set print order is impl-defined"
 "clojure.set/union:1"            "small-set print order is impl-defined"
 "clojure.set/union:2"            "small-set print order is impl-defined"
 "clojure.set/intersection:2"     "set print order is impl-defined"
 "clojure.set/project:1"          "small-set print order is impl-defined"
 ;; into:9 seeds a set from java.util.Set/of; contents identical,
 ;; iteration order differs from the JVM's HashSet buckets.
 "clojure.core/into:9"            "set hash-iteration order differs from JVM"
 ;; array-map:12 has 9 entries, past the 8-entry array threshold, so
 ;; both sides print promoted hash order; mino's small array-maps do
 ;; preserve insertion order.
 "clojure.core/array-map:12"      "9-entry map promoted to hash order, print impl-defined"
 ;; array-map:2's form under test is *clojure-version*, not an
 ;; array-map op; same class as subseq:5.
 "clojure.core/array-map:2"       "*clojure-version* reflects mino, not the JVM dialect"
 ;; hash-map:0 uses multi-slash keyword literals (:01/01/2012); the
 ;; ns/name split for those is unspecified and inconsistent even
 ;; across JVM entry points; mino uses a documented last-slash rule
 ;; and collapses the shared prefix under *print-namespace-maps*.
 "clojure.core/hash-map:0"        "multi-slash keyword ns split is unspecified; mino uses last-slash"
 ;; zipper locs are plain maps; mino's carry :changed? false and
 ;; :r () where the JVM impl leaves the key absent and :r nil; both
 ;; inert, plus impl-defined key order.
 "clojure.zip/xml-zip:0"          "zipper loc key order and inert :changed?/:r shape differ"

 ;; --- Java-only print shapes (mino ADR 67) ---
 ;;
 ;; mino prints its own types in portable tagged forms; the JVM
 ;; prints #object[...] with identity hashes, or #error with host
 ;; stack-trace serialisation (mino's error model is data, ADR 32/37/38).
 "clojure.core/ensure-reduced:0"  "#<reduced> vs JVM #object print form (ADR 67)"
 "clojure.core/ensure-reduced:1"  "#<reduced> vs JVM #object print form (ADR 67)"
 "clojure.core/ensure-reduced:2"  "#<reduced> vs JVM #object print form (ADR 67)"
 "clojure.core/unreduced:2"       "#<reduced> vs JVM #object print form (ADR 67)"
 "clojure.core/empty:0"           "#queue vs JVM Object.hashCode print form (ADR 67)"
 "clojure.core/empty:3"           "#queue vs JVM Object.hashCode print form (ADR 67)"
 "clojure.core/chunk-buffer:0"    "#chunk vs JVM object print form (ADR 67)"
 "clojure.core/ex-cause:0"        "error model is data, not #error host serialisation (ADR 32/37/38)"
 "clojure.core/ex-cause:1"        "error model is data, not #error host serialisation (ADR 32/37/38)"
 ;; pr-str:0's ground truth captured an unrealized lazy seq as a JVM
 ;; object-id string; mino realizes and prints the contents.
 "clojure.core/pr-str:0"          "JVM ground truth is an unrealized LazySeq object-id (ADR 67)"
 ;; get-in:0's preamble is pure Clojure; the diff is the ref print.
 "clojure.core/get-in:0"          "#ref print form vs JVM #object[...Ref] (ADR 67)"
 "clojure.core/get-thread-bindings:0"  "binding frame holds mino vars only, no host vars (ADR 67)"
 "clojure.core/str:0"             "str of a lazy seq prints contents, not host toString id (ADR 67)"

 ;; --- Java interop surfaces the examples lean on (mino ADR 67) ---
 "clojure.core/proxy-mappings:0"  "proxy needs a host to subclass (ADR 67)"
 "clojure.core/proxy-mappings:1"  "proxy needs a host to subclass (ADR 67)"
 "clojure.core/file-seq:0"        "clojure.java.io host namespace (ADR 67)"
 "clojure.core/file-seq:1"        "clojure.java.io host namespace (ADR 67)"
 "clojure.core/file-seq:2"        "clojure.java.io host namespace (ADR 67)"
 "clojure.core/uri?:0"            "preamble constructs java.net.URI (ADR 67)"
 "clojure.core/inst-ms:0"         "preamble (java.util.Date.); mino has its own time layer (ADR 21/67)"
 "clojure.core/boolean?:2"        "preamble (new Boolean ...) constructor sugar (ADR 67)"
 "clojure.core/double?:1"         "preamble (new Double ...) constructor sugar (ADR 67)"
 "clojure.core/int?:1"            "preamble java.lang.Integer. constructor sugar (ADR 67)"
 "clojure.core/int?:2"            "Long/MAX_VALUE is a value static; calling it raises MTY002 (ADR 67)"
 "clojure.core/bytes?:0"          "preamble (.getBytes ...) host method call (ADR 67)"
 "clojure.core/bytes?:1"          "preamble (.getBytes ...) host method call (ADR 67)"
 "clojure.core/identical?:0"      "preamble (String. ...) constructor sugar (ADR 67)"
 "clojure.core/identical?:1"      "preamble (String. ...) constructor sugar (ADR 67)"
 "clojure.core/identical?:2"      "preamble (String. ...) constructor sugar (ADR 67)"
 "clojure.core/identical?:3"      "preamble (String. ...) constructor sugar (ADR 67)"
 "clojure.core/partial:15"        "preamble Character/isLetter host static (ADR 67)"
 "clojure.string/replace:4"       "preamble imports java.util.regex.Matcher (ADR 67)"
 "clojure.string/replace:5"       "preamble imports java.util.regex.Matcher (ADR 67)"
 ;; defmulti examples dispatch a method on the Number class literal;
 ;; mino binds String/Long/Double/... as type keywords but has no
 ;; Number alias, so the preamble defmethod fails.
 "clojure.core/defmulti:0"        "preamble defmethod keyed on Number class literal (ADR 67)"
 "clojure.core/defmulti:1"        "preamble defmethod keyed on Number class literal (ADR 67)"
 "clojure.core/defmulti:2"        "preamble defmethod keyed on Number class literal (ADR 67)"
 ;; resolve examples assert the Java-class branch (java.util.Map).
 "clojure.core/resolve:0"         "expects java.util.Map class resolution (ADR 67)"
 "clojure.core/resolve:1"         "expects java.util.Map class resolution (ADR 67)"

 ;; --- Compiler / runtime internals ---
 ;;
 ;; Gensym spellings are internal compiler detail; mino emits
 ;; name__N__auto__, the JVM emits name__NNNN.
 "clojure.core/destructure:0"   "gensym spelling is compiler-internal"
 ;; subseq:5's ground truth is *clojure-version* on the JVM.
 "clojure.core/subseq:5"          "*clojure-version* reflects mino, not the JVM dialect"

 ;; --- spec.gen-backed examples with nondeterministic output ---
 ;;
 ;; mino ships clojure.spec.gen.alpha; deterministic gen-backed
 ;; examples pass. These pin literal gen/sample / g/generate output,
 ;; which is a PRNG snapshot no runtime can reproduce.
 "clojure.spec.alpha/map-of:4"        "gen/sample output is nondeterministic"
 "clojure.spec.alpha/map-of:5"        "gen/sample output is nondeterministic"
 "clojure.spec.alpha/with-gen"        "g/generate output is nondeterministic"
 "clojure.spec.alpha/conformer"       "gen/sample output is nondeterministic"

 ;; --- Byte-format examples (mino ADR 67) ---
 ;;
 ;; Both examples format (byte -128); mino has one integer tier and
 ;; no boxed Byte host type, so %x formats the 64-bit value.
 "clojure.core/bit-shift-right:1"          "(byte x) has no host Byte type; %x is 64-bit (ADR 67)"
 "clojure.core/unsigned-bit-shift-right:0" "(byte x) has no host Byte type; %x is 64-bit (ADR 67)"
}
