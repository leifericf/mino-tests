# local-only scratch / status / plans
.local/
*.local
.DS_Store

# build artifacts
*.o
*.a
*.dylib
*.so
*.profraw
*.profdata
tests/adv/build/
tests/mutation/build/
# Raw mull IDE dumps are regenerated; the scored .edn report is tracked.
tests/mutation/reports/*.ide.txt
tests/adv/coverage/report.html
tests/adv/coverage/*.html
tests/adv/coverage/snapshots/*.tmp
tests/adv/coverage/*.profraw
tests/adv/coverage/*.profdata
tests/adv/coverage/index.json

# ClojureDocs raw corpus (regenerated by `mino task clojuredocs-refresh`;
# only the parsed `clojuredocs-tuples.edn` fixture is checked in)
tests/adv/fixtures/clojuredocs-export.json

# sanitizer raw output
*.asan.log
*.tsan.log
*.ubsan.log
mino-dev

# Auto-captured regressions from probe runs (the dir itself stays
# tracked via .gitkeep so the probe has a place to write)
tests/adv/regressions/*.clj
